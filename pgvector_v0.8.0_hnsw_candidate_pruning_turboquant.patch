+/*
+ * hnswmeta.c
+ *
+ * TurboQuant-based neighbor metadata for HNSW candidate pruning.
+ *
+ * Algorithm overview (see DESIGNDOC.md and arXiv:2504.19874):
+ *
+ *  setNeighborMetadata (index build / insert):
+ *    1. Compute edge vector delta = neighbor - current.
+ *    2. Project delta onto the first quant_dim rows of the random rotation
+ *       matrix Pi (48 x HNSW_MAX_DIM), giving a rotated vector y[0..47].
+ *    3. Normalize y by ||delta|| so the codebook operates on a unit vector.
+ *    4. Scalar-quantize each y[j] with the Lloyd-Max codebook for N(0,1)
+ *       (b=2, 4 centroids).  Each index is 2 bits; pack 4 indices per byte.
+ *    5. Store: [float32 ||delta||^2] + [12 bytes of packed indices].
+ *
+ *  estimateDistances (index scan):
+ *    1. Compute query direction v = query - current.
+ *    2. Project v with the same rotation matrix -> v_rot[0..47].
+ *    3. For each neighbor entry, unpack indices -> centroid values -> delta_hat.
+ *    4. cos_est = dot(v_rot, delta_hat) / (||v_rot|| * ||delta||)
+ *                 (||delta|| is recovered from the stored float32).
+ *    5. Estimated L2^2 distance:
+ *         est = ||v||^2 + ||delta||^2 - 2 * ||v|| * ||delta|| * cos_est
+ */
+
+#include "postgres.h"
+
+#include <math.h>
+
+#include "catalog/pg_proc.h"
+#include "hnsw.h"
+#include "hnswmeta.h"
+#include "storage/bufmgr.h"
+#include "utils/float.h"
+#include "utils/datum.h"
+#include "utils/rel.h"
+#include "utils/syscache.h"
+
+#if defined(USE_TARGET_CLONES) && !defined(__FMA__)
+#define VECTOR_TARGET_CLONES __attribute__((target_clones("default", "fma")))
+#else
+#define VECTOR_TARGET_CLONES
+#endif
+
+/*
+ * Get whether neighbor metadata is stored in the index
+ */
+static bool
+HnswGetNeighborMetadata(Relation index)
+{
+	HnswOptions	   *opts = (HnswOptions *) index->rd_options;
+
+	if (opts)
+		return opts->neighborMetadata;
+
+	return HNSW_DEFAULT_NEIGHBOR_METADATA;
+}
+
+/*
+ * Check if neighbor metadata is supported
+ */
+bool
+HnswSupportNeighborMetadata(Relation index)
+{
+	const HnswTypeInfo *typeInfo = HnswGetTypeInfo(index);
+	return HnswGetNeighborMetadata(index) && typeInfo->neighborMetadataBytes > 0;
+}
+
+static bool
+CheckSupportFunctionName(FmgrInfo *distanceProcinfo, const char *targetFuncname)
+{
+	Oid				funcoid = distanceProcinfo->fn_oid;
+	HeapTuple		proctup;
+	Form_pg_proc	procform;
+	char		   *funcname = NULL;
+	bool			result = false;
+
+	proctup = SearchSysCache1(PROCOID, ObjectIdGetDatum(funcoid));
+	if (!HeapTupleIsValid(proctup))
+		return false;
+
+	procform = (Form_pg_proc) GETSTRUCT(proctup);
+	funcname = NameStr(procform->proname);
+
+	result = strcmp(funcname, targetFuncname) == 0;
+
+	ReleaseSysCache(proctup);
+
+	return result;
+}
+
+bool
+HnswIsVectorL2Distance(FmgrInfo *distanceProcinfo)
+{
+	return CheckSupportFunctionName(distanceProcinfo, "vector_l2_squared_distance");
+}
+
+bool
+HnswIsVectorCosine(FmgrInfo *distanceProcinfo, FmgrInfo *normProcinfo)
+{
+	if (normProcinfo == NULL)
+		return false;
+
+	if (CheckSupportFunctionName(distanceProcinfo, "vector_negative_inner_product") &&
+		CheckSupportFunctionName(normProcinfo, "vector_norm"))
+		return true;
+
+	return false;
+}
+
+/* -------------------------------------------------------------------------
+ * Internal helpers
+ * -------------------------------------------------------------------------
+ */
+
+VECTOR_TARGET_CLONES static float
+VectorInnerProductN(int dim, const float *ax, const float *bx)
+{
+	float distance = 0.0f;
+
+	for (int i = 0; i < dim; i++)
+		distance += ax[i] * bx[i];
+
+	return distance;
+}
+
+VECTOR_TARGET_CLONES static float
+VectorL2SquaredDistance(int dim, const float *ax, const float *bx)
+{
+	float distance = 0.0f;
+
+	for (int i = 0; i < dim; i++)
+	{
+		float diff = ax[i] - bx[i];
+		distance += diff * diff;
+	}
+
+	return distance;
+}
+
+/*
+ * Project a d-dimensional vector x onto the first quant_dim rows of the
+ * precomputed rotation matrix, writing results into y_out[0..quant_dim-1].
+ *
+ * quant_dim must be <= HNSW_TQ_QUANT_DIM_MAX.
+ * dim must be <= HNSW_MAX_DIM.
+ */
+VECTOR_TARGET_CLONES static void
+TurboQuantProject(int dim, const float *x, int quant_dim, float *y_out)
+{
+	int qdim = (quant_dim < dim) ? quant_dim : dim;
+
+	for (int i = 0; i < qdim; i++)
+		y_out[i] = VectorInnerProductN(dim, hnsw_tq_rotation[i], x);
+
+	/* Zero-fill unused slots when dim < quant_dim */
+	for (int i = qdim; i < quant_dim; i++)
+		y_out[i] = 0.0f;
+}
+
+/*
+ * Lloyd-Max scalar quantization for N(0,1) with b=2 (4 levels).
+ * Returns index in [0,3].
+ */
+static inline uint8
+TurboQuantScalar(float v)
+{
+	if (v < HNSW_TQ_BOUNDARY_01)
+		return 0;
+	else if (v < HNSW_TQ_BOUNDARY_12)
+		return 1;
+	else if (v < HNSW_TQ_BOUNDARY_23)
+		return 2;
+	else
+		return 3;
+}
+
+/*
+ * Centroid value for a given index (b=2).
+ */
+static inline float
+TurboQuantCentroid(uint8 idx)
+{
+	switch (idx)
+	{
+		case 0: return HNSW_TQ_CENTROID_0;
+		case 1: return HNSW_TQ_CENTROID_1;
+		case 2: return HNSW_TQ_CENTROID_2;
+		default: return HNSW_TQ_CENTROID_3;
+	}
+}
+
+/*
+ * Pack quant_dim 2-bit indices (values 0..3) into ceil(quant_dim/4) bytes.
+ * 4 indices per byte, LSB-first: byte[k] = idx[4k] | (idx[4k+1]<<2) | ...
+ */
+static void
+PackIndices2bit(const uint8 *indices, int quant_dim, char *packed)
+{
+	int nbytes = (quant_dim + 3) / 4;
+
+	memset(packed, 0, nbytes);
+	for (int i = 0; i < quant_dim; i++)
+		packed[i / 4] |= (char)((indices[i] & 0x3) << ((i % 4) * 2));
+}
+
+/*
+ * Unpack ceil(quant_dim/4) bytes back into quant_dim 2-bit indices.
+ */
+static void
+UnpackIndices2bit(const char *packed, int quant_dim, uint8 *indices)
+{
+	for (int i = 0; i < quant_dim; i++)
+		indices[i] = ((uint8) packed[i / 4] >> ((i % 4) * 2)) & 0x3;
+}
+
+/* -------------------------------------------------------------------------
+ * L2 distance metadata
+ * -------------------------------------------------------------------------
+ *
+ * Layout (16 bytes):
+ *   [0-3]   float32  ||delta||^2  (delta = neighbor - current)
+ *   [4-15]  uint8×12 packed 2-bit indices of the rotated+normalized delta
+ */
+
+void
+HnswSetVectorL2NeighborMetadata(char *metadata, Datum current, Datum neighbor)
+{
+	Vector *c = DatumGetVector(current);
+	Vector *n = DatumGetVector(neighbor);
+	int		dim = c->dim;
+	float	delta[HNSW_MAX_DIM];
+	float	y[HNSW_TQ_QUANT_DIM_MAX];
+	uint8	indices[HNSW_TQ_QUANT_DIM_MAX];
+	float	cn_dist;
+	float	norm;
+	int		quant_dim = (dim < HNSW_TQ_QUANT_DIM_MAX) ? dim : HNSW_TQ_QUANT_DIM_MAX;
+
+	/* Compute edge vector delta = n - c */
+	for (int i = 0; i < dim; i++)
+		delta[i] = n->x[i] - c->x[i];
+
+	cn_dist = VectorL2SquaredDistance(dim, c->x, n->x);
+
+	/* Project delta into rotated space */
+	TurboQuantProject(dim, delta, quant_dim, y);
+
+	/* Normalize by ||delta|| so codebook operates on unit-length coordinates */
+	norm = sqrtf(cn_dist);
+	if (norm > 1e-10f)
+	{
+		float inv_norm = 1.0f / norm;
+		for (int i = 0; i < quant_dim; i++)
+			y[i] *= inv_norm;
+	}
+
+	/* Scalar quantize each coordinate */
+	for (int i = 0; i < quant_dim; i++)
+		indices[i] = TurboQuantScalar(y[i]);
+
+	/* Write metadata: [float32 distance][12 bytes packed indices] */
+	memcpy(metadata, &cn_dist, sizeof(float));
+	PackIndices2bit(indices, HNSW_TQ_QUANT_DIM_MAX, metadata + sizeof(float));
+}
+
+void
+HnswEstimateVectorL2Distances(Datum current, Datum query, HnswNeighborEntry entries,
+							   int *unvisitedIndexes, int count)
+{
+	Vector *c = DatumGetVector(current);
+	Vector *q = DatumGetVector(query);
+	int		dim = c->dim;
+	float	v[HNSW_MAX_DIM];		/* query - current */
+	float	v_rot[HNSW_TQ_QUANT_DIM_MAX];
+	float	cq_dist;
+	float	v_norm;
+	int		quant_dim = (dim < HNSW_TQ_QUANT_DIM_MAX) ? dim : HNSW_TQ_QUANT_DIM_MAX;
+
+	/* v = query - current */
+	for (int i = 0; i < dim; i++)
+		v[i] = q->x[i] - c->x[i];
+
+	cq_dist = VectorL2SquaredDistance(dim, c->x, q->x);
+	v_norm  = sqrtf(cq_dist);
+
+	/* Rotate v */
+	TurboQuantProject(dim, v, quant_dim, v_rot);
+
+	for (int i = 0; i < count; i++)
+	{
+		HnswNeighborEntry entry = &entries[unvisitedIndexes[i]];
+		float	cn_dist;
+		uint8	indices[HNSW_TQ_QUANT_DIM_MAX];
+		float	delta_hat[HNSW_TQ_QUANT_DIM_MAX];
+		float	dot;
+		float	cn_norm;
+		float	cos_est;
+
+		if (!ItemPointerIsValid(&entry->indextid))
+			break;
+
+		/* Read stored metadata */
+		memcpy(&cn_dist, entry->metadata, sizeof(float));
+		UnpackIndices2bit(entry->metadata + sizeof(float), HNSW_TQ_QUANT_DIM_MAX, indices);
+
+		/* Reconstruct delta_hat from centroid values */
+		for (int j = 0; j < quant_dim; j++)
+			delta_hat[j] = TurboQuantCentroid(indices[j]);
+
+		/*
+		 * cos_est = dot(v_rot, delta_hat) / (||v_rot|| * 1.0)
+		 *
+		 * delta_hat is in the rotated space and was normalized before
+		 * quantization, so ||delta_hat|| ≈ 1.  We already have v_rot
+		 * (not normalized), so we divide by v_norm.
+		 *
+		 * Full estimate: ||q-n||^2 = ||v||^2 + ||delta||^2
+		 *                           - 2 * ||v|| * ||delta|| * cos_est
+		 */
+		dot = VectorInnerProductN(quant_dim, v_rot, delta_hat);
+		cn_norm = sqrtf(cn_dist);
+
+		if (v_norm > 1e-10f)
+			cos_est = dot / v_norm;		/* delta_hat has unit length in rotated space */
+		else
+			cos_est = 0.0f;
+
+		entry->distance = (double) cq_dist + (double) cn_dist
+						  - 2.0 * (double) v_norm * (double) cn_norm * (double) cos_est;
+	}
+}
+
+/* -------------------------------------------------------------------------
+ * Cosine distance metadata (disabled, kept for completeness)
+ * -------------------------------------------------------------------------
+ *
+ * Layout (8 bytes):
+ *   [0-7]  uint8×8  packed 2-bit indices (32 coords)
+ */
+
+void
+HnswSetVectorCosineNeighborMetadata(char *metadata, Datum current, Datum neighbor)
+{
+	Vector *c = DatumGetVector(current);
+	Vector *n = DatumGetVector(neighbor);
+	int		dim = c->dim;
+	float	delta[HNSW_MAX_DIM];
+	float	y[HNSW_TQ_QUANT_DIM_COSINE];
+	uint8	indices[HNSW_TQ_QUANT_DIM_COSINE];
+	float	norm2 = 0.0f;
+	float	norm;
+	int		quant_dim = (dim < HNSW_TQ_QUANT_DIM_COSINE) ? dim : HNSW_TQ_QUANT_DIM_COSINE;
+
+	for (int i = 0; i < dim; i++)
+		delta[i] = n->x[i] - c->x[i];
+
+	for (int i = 0; i < dim; i++)
+		norm2 += delta[i] * delta[i];
+
+	TurboQuantProject(dim, delta, quant_dim, y);
+
+	norm = sqrtf(norm2);
+	if (norm > 1e-10f)
+	{
+		float inv_norm = 1.0f / norm;
+		for (int i = 0; i < quant_dim; i++)
+			y[i] *= inv_norm;
+	}
+
+	for (int i = 0; i < quant_dim; i++)
+		indices[i] = TurboQuantScalar(y[i]);
+
+	PackIndices2bit(indices, HNSW_TQ_QUANT_DIM_COSINE, metadata);
+}
+
+void
+HnswEstimateVectorCosines(Datum current, Datum query, HnswNeighborEntry entries,
+						   int *unvisitedIndexes, int count)
+{
+	Vector *c = DatumGetVector(current);
+	Vector *q = DatumGetVector(query);
+	int		dim = c->dim;
+	float	v[HNSW_MAX_DIM];
+	float	v_rot[HNSW_TQ_QUANT_DIM_COSINE];
+	float	v_norm2 = 0.0f;
+	float	v_norm;
+	int		quant_dim = (dim < HNSW_TQ_QUANT_DIM_COSINE) ? dim : HNSW_TQ_QUANT_DIM_COSINE;
+
+	for (int i = 0; i < dim; i++)
+		v[i] = q->x[i] - c->x[i];
+
+	for (int i = 0; i < dim; i++)
+		v_norm2 += v[i] * v[i];
+
+	v_norm = sqrtf(v_norm2);
+
+	TurboQuantProject(dim, v, quant_dim, v_rot);
+
+	for (int i = 0; i < count; i++)
+	{
+		HnswNeighborEntry entry = &entries[unvisitedIndexes[i]];
+		uint8	indices[HNSW_TQ_QUANT_DIM_COSINE];
+		float	delta_hat[HNSW_TQ_QUANT_DIM_COSINE];
+		float	dot;
+		float	cos_est;
+
+		if (!ItemPointerIsValid(&entry->indextid))
+			break;
+
+		UnpackIndices2bit(entry->metadata, HNSW_TQ_QUANT_DIM_COSINE, indices);
+
+		for (int j = 0; j < quant_dim; j++)
+			delta_hat[j] = TurboQuantCentroid(indices[j]);
+
+		dot = VectorInnerProductN(quant_dim, v_rot, delta_hat);
+
+		if (v_norm > 1e-10f)
+			cos_est = dot / v_norm;
+		else
+			cos_est = 0.0f;
+
+		/* Return negative value because cosine distance requires negation */
+		entry->distance = -(double) cos_est;
+	}
+}
