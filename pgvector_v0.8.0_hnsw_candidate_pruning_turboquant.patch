+static void
+EstimateAndSortDistancesFromMetadata(char *base, HnswElement element, HnswQuery * q, const HnswTypeInfo * typeInfo, HnswNeighborEntryData *entries, int *unvisitedIndexes, int *unvisitedLength)
+{
+	if (*unvisitedLength == 0)
+		return;
+
+	int maxNeighborEntries = unvisitedIndexes[(*unvisitedLength) - 1] + 1;
+
+	/*
+	 * Initialize with DBL_MAX so that unused entries are placed
+	 * at the end of the array after sorting
+	 */
+	for (int i = 0; i < maxNeighborEntries; i++)
+		entries[i].distance = DBL_MAX;
+
+	typeInfo->estimateDistances(HnswGetValue(base, element), q->value, entries, unvisitedIndexes, *unvisitedLength);
+
+	/* Sort distances in ascending order for processing prioritization */
+	qsort(entries, maxNeighborEntries, sizeof(HnswNeighborEntryData), CompareNearestNeighborEntries);
+}
