+/*
+ * Compute the on-disk neighbor metadata bytes for a given vector dimension.
+ *
+ * Layout: sizeof(float32) for ||delta||^2 + ceil(2*n_rot/8) bytes for 2-bit codes,
+ * where n_rot = Min(dim, HNSW_TQ_ROTATION_ROWS).
+ *
+ * When n_rot < HNSW_TQ_L2_MIN_ROT, only the 4-byte float32 norm is stored;
+ * estimates are too noisy with fewer rotation rows.
+ */
+int
+HnswComputeNeighborMetadataBytes(int dim)
+{
+	int	n_rot = (dim < HNSW_TQ_ROTATION_ROWS) ? dim : HNSW_TQ_ROTATION_ROWS;
+
+	if (n_rot < HNSW_TQ_L2_MIN_ROT)
+		return (int) sizeof(float);		/* norm only; too few rows for reliable estimates */
+
+	return (int) sizeof(float) + (2 * n_rot + 7) / 8;
+}
