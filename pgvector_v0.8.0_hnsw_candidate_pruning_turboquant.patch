+ * Neighbor metadata layout (TurboQuant, b=2):
+ *
+ * L2 (16 bytes):
+ *   [0-3]   float32  ||n - c||^2    (L2 squared distance current -> neighbor)
+ *   [4-15]  uint8×12 packed indices  (48 coords × 2 bits, packed 4 per byte)
+ *
+ * Cosine (8 bytes):
+ *   [0-7]  uint8×8  packed indices  (32 coords × 2 bits, packed 4 per byte)
+ */
+#define HNSW_NEIGHBOR_VECTOR_L2_METADATA_BYTES		16
+#define HNSW_NEIGHBOR_VECTOR_COSINE_METADATA_BYTES	8
