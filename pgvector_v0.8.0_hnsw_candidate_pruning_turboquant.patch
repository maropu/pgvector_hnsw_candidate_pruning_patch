@@ -0,0 +1,30 @@
+#ifndef HNSW_TQ_H
+#define HNSW_TQ_H
+
+#include "hnsw.h"
+
+/*
+ * TurboQuant constants for HNSW neighbor metadata compression.
+ *
+ * We quantize the edge vector (neighbor - current) in a randomly-rotated
+ * coordinate space using a Lloyd-Max codebook optimal for N(0,1).
+ *
+ * Bit-width b=2: 4 centroids, 2 bits per coordinate.
+ * Max quantized dimensions: 48 (fits in 12 bytes = 96 bits, leaving 4 bytes
+ * for the L2 distance).
+ */
+
+/* Quantization parameters */
+#define HNSW_TQ_BIT_WIDTH			2
+#define HNSW_TQ_NUM_LEVELS			4		/* 2^HNSW_TQ_BIT_WIDTH */
+#define HNSW_TQ_QUANT_DIM_MAX		48		/* rows kept from the rotation matrix */
+#define HNSW_TQ_QUANT_DIM_COSINE	32		/* rows used for cosine (8 bytes / 2 bits) */
+
+/*
+ * Precomputed random rotation matrix (48 rows × HNSW_MAX_DIM cols).
+ * Only the first min(dim, HNSW_TQ_QUANT_DIM_MAX) rows are used.
+ * Generated with numpy seed=42 + QR decomposition.
+ */
+extern const float hnsw_tq_rotation[HNSW_TQ_QUANT_DIM_MAX][HNSW_MAX_DIM];
+
+#endif	/* HNSW_TQ_H */
