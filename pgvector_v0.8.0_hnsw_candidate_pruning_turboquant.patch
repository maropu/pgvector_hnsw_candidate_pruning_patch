+static int
+CompareNearestNeighborEntries(const void *a, const void *b)
+{
+	HnswNeighborEntryData *entryA = (HnswNeighborEntryData *) a;
+	HnswNeighborEntryData *entryB = (HnswNeighborEntryData *) b;
+
+	if (entryA->distance < entryB->distance)
+		return -1;
