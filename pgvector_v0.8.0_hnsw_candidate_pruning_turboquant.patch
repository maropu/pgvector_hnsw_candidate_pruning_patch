@@ -0,0 +1,43 @@
+#ifndef HNSW_META_H
+#define HNSW_META_H
+
+#include "postgres.h"
+
+#include "hnsw.h"
+#include "hnswtq.h"
+#include "utils/relcache.h"
+
+/*
+ * Neighbor metadata layout:
+ *
+ * L2 (variable size, stored in MetaPage as neighborMetadataBytes):
+ *   [0-3]   float32  ||n - c||^2    (L2 squared distance current -> neighbor)
+ *   [4..]   ceil(2·n_rot/8) bytes   2-bit code per rotated coordinate
+ *            bits [2j,2j+1] = quantized ỹ_j = y_j·sqrt(dim)/||delta||
+ *            where n_rot = Min(dim, HNSW_TQ_ROTATION_ROWS)
+ *            code 0→−1.5252, 1→−0.4599, 2→+0.4599, 3→+1.5252  (thresholds ±1)
+ *   Total: sizeof(float32) + ceil(2·n_rot/8) bytes
+ *   (4 bytes only when n_rot < HNSW_TQ_L2_MIN_ROT; estimates too noisy)
+ *
+ * Cosine (8 bytes, currently disabled):
+ *   [0-7]   uint8×8  M=8 partition scalars × 8 bits
+ */
+
+/* Fixed cosine metadata size (kept for potential future use) */
+#define HNSW_NEIGHBOR_VECTOR_COSINE_METADATA_BYTES	8
+
+/* Utility macros */
+#define HnswVectorIsLoaded(base, element) (DatumGetPointer(HnswGetValue((base), (element))) != NULL)
+
+/* As post-processing of HNSW search, recheck data points whose distance to query q has been estimated */
+#define HNSW_SCAN_ESTIMATED_DISTANCE_QUEUE
+
+/* Methods */
+bool	HnswIsVectorL2Distance(FmgrInfo *distanceProcinfo);
+bool	HnswIsVectorCosine(FmgrInfo *distanceProcinfo, FmgrInfo *normProcinfo);
+void	HnswSetVectorL2NeighborMetadata(char *metadata, Datum current, Datum neighbor);
+void	HnswSetVectorCosineNeighborMetadata(char *metadata, Datum current, Datum neighbor);
+void	HnswEstimateVectorL2Distances(Datum current, Datum query, HnswNeighborEntry entries, int *indexes, int count);
+void	HnswEstimateVectorCosines(Datum current, Datum query, HnswNeighborEntry entries, int *indexes, int count);
+
+#endif	/* HNSW_META_H */
