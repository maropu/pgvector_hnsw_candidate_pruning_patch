+#ifndef HNSW_TQ_H
+#define HNSW_TQ_H
+
+#include "hnsw.h"
+
+/*
+ * TurboQuant constants for HNSW neighbor metadata compression.
+ *
+ * HNSW_TQ_ROTATION_ROWS: number of rows in the precomputed rotation matrix.
+ * For a vector of dimension d, n_rot = Min(d, HNSW_TQ_ROTATION_ROWS) rows are
