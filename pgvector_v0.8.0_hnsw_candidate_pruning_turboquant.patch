diff --git a/src/hnswmeta.c b/src/hnswmeta.c
new file mode 100644
index 0000000..c8631be
--- /dev/null
+++ b/src/hnswmeta.c
@@ -0,0 +1,542 @@
+/*
+ * hnswmeta.c
+ *
+ * TurboQuant-based neighbor metadata for HNSW candidate pruning.
+ *
+ * -------------------------------------------------------------------------
+ * Key mathematical insight
+ * -------------------------------------------------------------------------
+ * After applying the precomputed random rotation R, the rotated edge vector
+ * y = R · delta has coordinates y_j that are approximately i.i.d.
+ * N(0, ||delta||² / dim) (concentration of measure in high dimensions).
+ *
+ * We normalize each coordinate: ỹ_j = y_j · sqrt(dim) / ||delta|| ~ N(0, 1),
+ * then quantize ỹ_j to 2 bits using thresholds {-1, 0, +1}:
+ *
+ *   code 0 (ỹ_j < -1)    → q̃_j = E[Z | Z < -1]    ≈ -1.5252
+ *   code 1 (-1 ≤ ỹ_j < 0) → q̃_j = E[Z | -1 ≤ Z < 0] ≈ -0.4599
+ *   code 2 ( 0 ≤ ỹ_j < 1) → q̃_j = E[Z |  0 ≤ Z < 1] ≈ +0.4599
+ *   code 3 (ỹ_j ≥ 1)     → q̃_j = E[Z | Z ≥ 1]     ≈ +1.5252
+ *
+ * At query time the inner product <v, delta> is estimated by Price's theorem:
+ *
+ *   E[w_j · q̃(ỹ_j)] = C₂ · Cov(w_j, ỹ_j) = C₂ · <v, delta> / (||delta|| · sqrt(dim))
+ *
+ * where w_j = (R·v)_j and C₂ = E[Z·q̃(Z)] ≈ 0.8828 for our 4-level quantizer.
+ *
+ * The unbiased estimator is therefore:
+ *
+ *   <v, delta>_est = ||delta|| · sqrt(dim) / (n_rot · C₂) · Σ_j w_j · q̃_j
+ *
+ * Using 2 bits instead of 1 increases the effective signal strength by
+ * C₂/C₁ = 0.8828 / sqrt(2/π) ≈ 1.107 (≈ 10.7% stronger, lower MSE).
+ *
+ * -------------------------------------------------------------------------
+ * setNeighborMetadata (index build / insert):
+ * -------------------------------------------------------------------------
+ *   1. Compute edge vector delta = neighbor - current; cn_norm = ||delta||.
+ *   2. Compute n_rot = Min(dim, HNSW_TQ_ROTATION_ROWS).
+ *   3. If n_rot < HNSW_TQ_L2_MIN_ROT: store only float32 norm (4 bytes).
+ *   4. Rotate: y = R · delta  (first n_rot rows of rotation matrix).
+ *   5. Normalize: ỹ_j = y_j · sqrt(dim) / cn_norm.
+ *   6. Store float32 ||delta||² at bytes [0-3].
+ *   7. Store 2-bit codes at bytes [4 .. 4+ceil(2·n_rot/8)-1]:
+ *        bits [2j, 2j+1] = quantized code for ỹ_j.
+ *
+ * -------------------------------------------------------------------------
+ * estimateDistances (index scan):
+ * -------------------------------------------------------------------------
+ *   1. Compute query direction v = query - current.
+ *   2. Rotate: w = R · v  (same n_rot rows).
+ *   3. Precompute scale = sqrt(dim) / (n_rot · C₂).
+ *   4. For each neighbor entry:
+ *        a. Read cn_dist = ||delta||² from bytes [0-3]; cn_norm = sqrt(cn_dist).
+ *        b. If n_rot < HNSW_TQ_L2_MIN_ROT: use conservative bound cq_dist + cn_dist.
+ *        c. dot = Σ_j w[j] · dq[code_j]   (dq = {-1.5252,-0.4599,+0.4599,+1.5252})
+ *        d. <v, delta>_est = cn_norm · scale · dot
+ *        e. est = ||v||² + ||delta||² - 2 · <v, delta>_est
+ */
+
+#include "postgres.h"
+
+#include <math.h>
+
+#include "catalog/pg_proc.h"
+#include "hnsw.h"
+#include "hnswmeta.h"
+#include "storage/bufmgr.h"
+#include "utils/float.h"
+#include "utils/datum.h"
+#include "utils/rel.h"
+#include "utils/syscache.h"
+
+#if defined(USE_TARGET_CLONES) && !defined(__FMA__)
+#define VECTOR_TARGET_CLONES __attribute__((target_clones("default", "fma")))
+#else
+#define VECTOR_TARGET_CLONES
+#endif
+
+/*
+ * Get whether neighbor metadata is stored in the index
+ */
+static bool
+HnswGetNeighborMetadata(Relation index)
+{
+	HnswOptions	   *opts = (HnswOptions *) index->rd_options;
+
+	if (opts)
+		return opts->neighborMetadata;
+
+	return HNSW_DEFAULT_NEIGHBOR_METADATA;
+}
+
+/*
+ * Check if neighbor metadata is supported
+ */
+bool
+HnswSupportNeighborMetadata(Relation index)
+{
+	const HnswTypeInfo *typeInfo = HnswGetTypeInfo(index);
+	return HnswGetNeighborMetadata(index) && typeInfo->neighborMetadataBytes > 0;
+}
+
+static bool
+CheckSupportFunctionName(FmgrInfo *distanceProcinfo, const char *targetFuncname)
+{
+	Oid				funcoid = distanceProcinfo->fn_oid;
+	HeapTuple		proctup;
+	Form_pg_proc	procform;
+	char		   *funcname = NULL;
+	bool			result = false;
+
+	proctup = SearchSysCache1(PROCOID, ObjectIdGetDatum(funcoid));
+	if (!HeapTupleIsValid(proctup))
+		return false;
+
+	procform = (Form_pg_proc) GETSTRUCT(proctup);
+	funcname = NameStr(procform->proname);
+
+	result = strcmp(funcname, targetFuncname) == 0;
+
+	ReleaseSysCache(proctup);
+
+	return result;
+}
+
+bool
+HnswIsVectorL2Distance(FmgrInfo *distanceProcinfo)
+{
+	return CheckSupportFunctionName(distanceProcinfo, "vector_l2_squared_distance");
+}
+
+bool
+HnswIsVectorCosine(FmgrInfo *distanceProcinfo, FmgrInfo *normProcinfo)
+{
+	if (normProcinfo == NULL)
+		return false;
+
+	if (CheckSupportFunctionName(distanceProcinfo, "vector_negative_inner_product") &&
+		CheckSupportFunctionName(normProcinfo, "vector_norm"))
+		return true;
+
+	return false;
+}
+
+/* -------------------------------------------------------------------------
+ * Internal helpers
+ * -------------------------------------------------------------------------
+ */
+
+VECTOR_TARGET_CLONES static float
+VectorInnerProductN(int dim, const float *ax, const float *bx)
+{
+	float distance = 0.0f;
+
+	for (int i = 0; i < dim; i++)
+		distance += ax[i] * bx[i];
+
+	return distance;
+}
+
+VECTOR_TARGET_CLONES static float
+VectorL2SquaredDistance(int dim, const float *ax, const float *bx)
+{
+	float distance = 0.0f;
+
+	for (int i = 0; i < dim; i++)
+	{
+		float diff = ax[i] - bx[i];
+		distance += diff * diff;
+	}
+
+	return distance;
+}
+
+/*
+ * Project a d-dimensional vector x onto the first n_rot rows of the
+ * precomputed rotation matrix, writing results into y_out[0..n_rot-1].
+ *
+ * n_rot must be <= HNSW_TQ_ROTATION_ROWS.
+ * dim  must be <= HNSW_MAX_DIM.
+ */
+VECTOR_TARGET_CLONES static void
+TurboQuantProject(int dim, const float *x, int n_rot, float *y_out)
+{
+	int nrows = (n_rot < dim) ? n_rot : dim;
+
+	for (int i = 0; i < nrows; i++)
+		y_out[i] = VectorInnerProductN(dim, hnsw_tq_rotation[i], x);
+
+	/* Zero-fill when dim < n_rot (should not happen in normal use) */
+	for (int i = nrows; i < n_rot; i++)
+		y_out[i] = 0.0f;
+}
+
+/* -------------------------------------------------------------------------
+ * 8-bit uniform quantiser  (cosine, range ±HNSW_TQ_COSINE_QUANT_CLIP)
+ * -------------------------------------------------------------------------
+ */
+static inline uint8
+QuantScalar8bit(float v)
+{
+	const float clip  = HNSW_TQ_COSINE_QUANT_CLIP;
+	const float scale = (float)(HNSW_TQ_COSINE_QUANT_LEVELS - 1) / (2.0f * clip);
+
+	if (v <= -clip)
+		return 0;
+	if (v >= clip)
+		return (uint8)(HNSW_TQ_COSINE_QUANT_LEVELS - 1);
+	return (uint8)((v + clip) * scale + 0.5f);
+}
+
+static inline float
+DequantScalar8bit(uint8 idx)
+{
+	const float clip = HNSW_TQ_COSINE_QUANT_CLIP;
+	const float step = 2.0f * clip / (float)(HNSW_TQ_COSINE_QUANT_LEVELS - 1);
+
+	return -clip + (float)idx * step;
+}
+
+/* -------------------------------------------------------------------------
+ * Compute cosine partition parameters given a vector dimension.
+ *
+ * n_rot : rotation rows rounded down to a multiple of part_dim.
+ * m     : number of active partitions = n_rot / part_dim.
+ * -------------------------------------------------------------------------
+ */
+static inline void
+TurboQuantCosinePartitionParams(int dim, int *n_rot_out, int *m_out)
+{
+	int n_rot = (dim < HNSW_TQ_ROTATION_ROWS) ? dim : HNSW_TQ_ROTATION_ROWS;
+	int part_dim = HNSW_TQ_COSINE_PARTITION_DIM;
+
+	/* Round down to a multiple of part_dim */
+	n_rot = (n_rot / part_dim) * part_dim;
+
+	*n_rot_out = n_rot;
+	*m_out     = (part_dim > 0) ? n_rot / part_dim : 0;
+}
+
+/* -------------------------------------------------------------------------
+ * L2 distance metadata  —  2-bit normalized Gaussian quantization
+ * -------------------------------------------------------------------------
+ *
+ * Layout (variable, sizeof(float32) + ceil(2·n_rot/8) bytes):
+ *   [0-3]   float32  ||delta||^2  (delta = neighbor - current)
+ *   [4..]   ceil(2·n_rot/8) bytes  2-bit codes for rotated coordinates
+ *            bits [2j,2j+1] = code for ỹ_j = y_j·sqrt(dim)/||delta||
+ *            code 0→-1.5252, 1→-0.4599, 2→+0.4599, 3→+1.5252 (thresholds ±1)
+ *
+ * n_rot = Min(dim, HNSW_TQ_ROTATION_ROWS); the total byte count is written
+ * to the MetaPage at build time and passed through typeInfo->neighborMetadataBytes.
+ *
+ * When n_rot < HNSW_TQ_L2_MIN_ROT only the 4-byte float32 norm is stored;
+ * callers then use a conservative upper bound instead of the noisy estimate.
+ */
+
+void
+HnswSetVectorL2NeighborMetadata(char *metadata, Datum current, Datum neighbor)
+{
+	Vector *c       = DatumGetVector(current);
+	Vector *n       = DatumGetVector(neighbor);
+	int		dim     = c->dim;
+	float	delta[HNSW_MAX_DIM];
+	float	y[HNSW_TQ_ROTATION_ROWS];
+	float	cn_dist;
+	float	cn_norm;
+	int		n_rot   = (dim < HNSW_TQ_ROTATION_ROWS) ? dim : HNSW_TQ_ROTATION_ROWS;
+	int		nbytes  = (2 * n_rot + 7) / 8;
+
+	/* Compute edge vector delta = n - c */
+	for (int i = 0; i < dim; i++)
+		delta[i] = n->x[i] - c->x[i];
+
+	cn_dist = VectorL2SquaredDistance(dim, c->x, n->x);
+	cn_norm = sqrtf(cn_dist);
+
+	/* Store ||delta||^2 */
+	memcpy(metadata, &cn_dist, sizeof(float));
+
+	/*
+	 * For n_rot < HNSW_TQ_L2_MIN_ROT, store only the norm.
+	 * Estimates are too noisy with fewer than HNSW_TQ_L2_MIN_ROT rotation rows.
+	 */
+	if (n_rot < HNSW_TQ_L2_MIN_ROT || cn_norm <= 1e-10f)
+		return;
+
+	/* Rotate delta: y[j] = (R·delta)[j] for j = 0..n_rot-1 */
+	TurboQuantProject(dim, delta, n_rot, y);
+
+	/*
+	 * Normalize to ~N(0,1): ỹ_j = y_j * sqrt(dim) / cn_norm.
+	 * Quantize with thresholds {-1, 0, +1}: code ∈ {0,1,2,3}.
+	 * Pack 2-bit codes at bits [2j, 2j+1].
+	 */
+	{
+		float norm_scale = sqrtf((float) dim) / cn_norm;
+
+		memset(metadata + sizeof(float), 0, nbytes);
+		for (int j = 0; j < n_rot; j++)
+		{
+			float	z        = y[j] * norm_scale;
+			int		q;
+			int		byte_idx = j / 4;
+			int		bit_off  = (j % 4) * 2;
+
+			if (z < -1.0f)
+				q = 0;
+			else if (z < 0.0f)
+				q = 1;
+			else if (z < 1.0f)
+				q = 2;
+			else
+				q = 3;
+
+			((uint8 *)(metadata + sizeof(float)))[byte_idx] |= (uint8)(q << bit_off);
+		}
+	}
+}
+
+/*
+ * Estimate L2² distances from current to each neighbor using stored 2-bit codes.
+ *
+ * Estimator (asymptotically unbiased via Price's theorem):
+ *   <v, delta>_est = cn_norm · sqrt(dim) / (n_rot · C₂) · Σ_j w[j] · dq[code_j]
+ *
+ * where v = query - current, w = R·v, dq[] = {-1.5252,-0.4599,+0.4599,+1.5252}
+ * are the conditional expectations E[Z|bin] for Z~N(0,1) with thresholds at ±1,
+ * cn_norm = ||delta||, and C₂ = HNSW_TQ_L2_2BIT_C2 ≈ 0.8828.
+ */
+void
+HnswEstimateVectorL2Distances(Datum current, Datum query, HnswNeighborEntry entries,
+							   int *unvisitedIndexes, int count)
+{
+	Vector *c   = DatumGetVector(current);
+	Vector *q   = DatumGetVector(query);
+	int		dim = c->dim;
+	float	v[HNSW_MAX_DIM];
+	float	w_rot[HNSW_TQ_ROTATION_ROWS];
+	float	cq_dist;
+	int		n_rot = (dim < HNSW_TQ_ROTATION_ROWS) ? dim : HNSW_TQ_ROTATION_ROWS;
+	float	scale;  /* sqrt(dim) / (n_rot · C₂), applied per-entry with cn_norm */
+
+	/*
+	 * Dequantization table: E[Z|bin k] for Z~N(0,1) with thresholds at {-1,0,+1}.
+	 *   bin 0: Z < -1   → -φ(1)/Φ(-1)          ≈ -1.5252
+	 *   bin 1: -1≤Z<0   → (φ(-1)-φ(0))/P(bin)  ≈ -0.4599
+	 *   bin 2: 0≤Z<1    → (φ(0)-φ(1))/P(bin)   ≈ +0.4599
+	 *   bin 3: Z ≥ 1    →  φ(1)/Φ(-1)          ≈ +1.5252
+	 */
+	static const float dq[4] = {-1.5252f, -0.4599f, +0.4599f, +1.5252f};
+
+	/* v = query - current */
+	for (int i = 0; i < dim; i++)
+		v[i] = q->x[i] - c->x[i];
+
+	cq_dist = VectorL2SquaredDistance(dim, c->x, q->x);
+
+	if (n_rot >= HNSW_TQ_L2_MIN_ROT)
+	{
+		TurboQuantProject(dim, v, n_rot, w_rot);
+		scale = sqrtf((float) dim) / ((float) n_rot * HNSW_TQ_L2_2BIT_C2);
+	}
+
+	for (int i = 0; i < count; i++)
+	{
+		HnswNeighborEntry entry = &entries[unvisitedIndexes[i]];
+		float		cn_dist;
+		float		cn_norm;
+		const uint8 *bits;
+		float		dot;
+
+		if (!ItemPointerIsValid(&entry->indextid))
+			break;
+
+		/* Read stored ||delta||^2 */
+		memcpy(&cn_dist, entry->metadata, sizeof(float));
+		cn_norm = sqrtf(cn_dist);
+
+		if (n_rot < HNSW_TQ_L2_MIN_ROT || cn_norm <= 1e-10f)
+		{
+			/* Too few rotation rows or degenerate edge; use conservative upper bound */
+			entry->distance = (double) cq_dist + (double) cn_dist;
+			continue;
+		}
+
+		bits = (const uint8 *)(entry->metadata + sizeof(float));
+		dot  = 0.0f;
+		for (int j = 0; j < n_rot; j++)
+		{
+			int byte_idx = j / 4;
+			int bit_off  = (j % 4) * 2;
+			int code     = (bits[byte_idx] >> bit_off) & 0x3;
+
+			dot += w_rot[j] * dq[code];
+		}
+
+		/*
+		 * Estimated L2² distance:
+		 *   est = ||v||² + ||delta||² - 2 · cn_norm · scale · dot
+		 * where scale = sqrt(dim) / (n_rot · C₂).
+		 */
+		entry->distance = (double) cq_dist + (double) cn_dist
+						  - 2.0 * (double) cn_norm * (double) scale * (double) dot;
+	}
+}
+
+/* -------------------------------------------------------------------------
+ * Cosine distance metadata
+ * -------------------------------------------------------------------------
+ *
+ * Layout (8 bytes):
+ *   [0-7]  uint8×8  8 × 8-bit partition scalars
+ *
+ * Uses the same algorithm as L2 but with K = HNSW_TQ_COSINE_PARTITION_DIM
+ * (8 instead of 16) to fit within 8 bytes at 8 bits/partition.
+ */
+
+void
+HnswSetVectorCosineNeighborMetadata(char *metadata, Datum current, Datum neighbor)
+{
+	Vector *c   = DatumGetVector(current);
+	Vector *n   = DatumGetVector(neighbor);
+	int		dim = c->dim;
+	float	delta[HNSW_MAX_DIM];
+	float	y[HNSW_TQ_ROTATION_ROWS];
+	float	norm2 = 0.0f;
+	float	norm;
+	int		n_rot,
+			k,
+			m;
+
+	for (int i = 0; i < dim; i++)
+		delta[i] = n->x[i] - c->x[i];
+
+	for (int i = 0; i < dim; i++)
+		norm2 += delta[i] * delta[i];
+	norm = sqrtf(norm2);
+
+	TurboQuantCosinePartitionParams(dim, &n_rot, &m);
+	k = HNSW_TQ_COSINE_PARTITION_DIM;
+
+	if (m == 0 || norm <= 1e-10f)
+	{
+		memset(metadata, 0, HNSW_NEIGHBOR_VECTOR_COSINE_METADATA_BYTES);
+		return;
+	}
+
+	TurboQuantProject(dim, delta, n_rot, y);
+
+	{
+		float scale_store = sqrtf((float) dim) / (norm * sqrtf((float) k));
+
+		for (int i = 0; i < m; i++)
+		{
+			float s = 0.0f;
+
+			for (int j = 0; j < k; j++)
+				s += y[i * k + j];
+
+			metadata[i] = (char) QuantScalar8bit(s * scale_store);
+		}
+	}
+
+	for (int i = m; i < HNSW_TQ_COSINE_NUM_PARTITIONS; i++)
+		metadata[i] = (char)(HNSW_TQ_COSINE_QUANT_LEVELS / 2);
+}
+
+void
+HnswEstimateVectorCosines(Datum current, Datum query, HnswNeighborEntry entries,
+						   int *unvisitedIndexes, int count)
+{
+	Vector *c   = DatumGetVector(current);
+	Vector *q   = DatumGetVector(query);
+	int		dim = c->dim;
+	float	v[HNSW_MAX_DIM];
+	float	w_rot[HNSW_TQ_ROTATION_ROWS];
+	float	v_norm2 = 0.0f;
+	float	v_norm;
+	int		n_rot,
+			k,
+			m;
+	float	sum_w[HNSW_TQ_COSINE_NUM_PARTITIONS];
+	float	scale_query;
+
+	for (int i = 0; i < dim; i++)
+		v[i] = q->x[i] - c->x[i];
+
+	for (int i = 0; i < dim; i++)
+		v_norm2 += v[i] * v[i];
+	v_norm = sqrtf(v_norm2);
+
+	TurboQuantCosinePartitionParams(dim, &n_rot, &m);
+	k = HNSW_TQ_COSINE_PARTITION_DIM;
+
+	if (m > 0)
+	{
+		TurboQuantProject(dim, v, n_rot, w_rot);
+
+		for (int i = 0; i < m; i++)
+		{
+			float s = 0.0f;
+
+			for (int j = 0; j < k; j++)
+				s += w_rot[i * k + j];
+
+			sum_w[i] = s;
+		}
+
+		scale_query = sqrtf((float) dim) / ((float) m * sqrtf((float) k));
+	}
+
+	for (int i = 0; i < count; i++)
+	{
+		HnswNeighborEntry entry = &entries[unvisitedIndexes[i]];
+		float	dot;
+		float	cos_est;
+
+		if (!ItemPointerIsValid(&entry->indextid))
+			break;
+
+		if (m == 0 || v_norm <= 1e-10f)
+		{
+			entry->distance = 0.0;
+			continue;
+		}
+
+		dot = 0.0f;
+		for (int j = 0; j < m; j++)
+			dot += DequantScalar8bit((uint8) entry->metadata[j]) * sum_w[j];
+
+		/*
+		 * cos_est = <v, delta>_est / (||v|| * ||delta||)
+		 *         = scale_query * dot / v_norm
+		 * (||delta|| = 1 for unit-normalised vectors in cosine distance)
+		 */
+		cos_est = scale_query * dot / v_norm;
+
+		/* Return negative value because cosine distance requires negation */
+		entry->distance = -(double) cos_est;
+	}
+}
